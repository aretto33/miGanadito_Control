# =========================
# Vercel + Supabase
# =========================
# Estas son las variables que SI necesita la app Flask para deploy.
SECRET_KEY=pon_aqui_un_valor_largo_y_seguro
DATABASE_URL=postgresql://postgres.xxxxx:tu_password@aws-1-us-east-1.pooler.supabase.com:6543/postgres
FLASK_DEBUG=false

# Alias opcional legado. La app prefiere DATABASE_URL.
SUPABASE_DB_URL=

# Estas variables NO conectan Flask a la base.
# Solo sirven si despues usas el cliente REST/JS de Supabase.
SUPABASE_URL=
SUPABASE_KEY=

# =========================
# Modo local con MySQL/MariaDB
# =========================
# Solo usalas si trabajas en local sin Supabase.
DB_HOST=localhost
DB_PORT=3306
DB_USER=arletteg
DB_PASSWORD=123456
DB_NAME=Proyecto_Ganaderia2

